# Application Name
APP_NAME=DynamicVault QR

PORT=5000
# Database URL
MONGO_URI=mongodb://127.0.0.1:27017/dynamicvault_qr
# JWT Secret Key
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=8h
# Frontend URL
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

NODE_ENV=development
# Admin Credentials
ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=admin123
# Recycle Pin
RECYCLE_PIN=1234
# Max file size in MB
MAX_FILE_SIZE_MB=10
# Default file size in MB
DEFAULT_FILE_SIZE_MB=15

ADMIN_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5174
PUBLIC_BASE_URL=http://localhost:5174
